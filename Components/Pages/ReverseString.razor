@page "/reversestring"

<PageTitle>Reverse string</PageTitle>
<h3>Reverse this string</h3>

<div class="vstack gap-3 col-8 col-md-6">
    <InputText class="form-control" placeholder="Enter a string to reverse..." @bind-Value="inputString" @oninput="Refresh" />
    <div class="text-end">
        <button class="btn btn-primary" @onclick="ReverseThisString">Reverse the string</button>
    </div>
    <p role="contentinfo">Data entered: '@inputString'</p>
</div>

@if (showResult)
{
    <Message DisplayMessage="@displayMessage" Title="Result" CssClass="alert-danger" />
    @if (isPalindrome)
    {
        <Message DisplayMessage="The message is a palindrome!" CssClass="alert-success"></Message>
    }
    else
    {
        <Message DisplayMessage="The message is not palindrome!" CssClass="alert-primary"></Message>
    }
}

@code {
    private string inputString = "";
    private string outputString = "";
    private string displayMessage = "";
    private bool showResult = false;
    private bool isPalindrome = false;

    private void Refresh()
    {
        showResult = false;
    }

    private void ReverseThisString()
    {
        outputString = string.Empty;

        for(var i = inputString.Length - 1; i >= 0; i--)
        {
            outputString += inputString[i];
        }

        isPalindrome = inputString == outputString;

        displayMessage = $"Data '{inputString}' transformed is '{outputString}'";
        showResult = true;
    }
}
