@page "/reversestring"

<PageTitle>Reverse string</PageTitle>
<h3>Reverse this string</h3>

<div class="vstack gap-3 col-8 col-md-6">
    <InputText class="form-control" placeholder="Enter a string to reverse..." @bind-Value="inputString"/>
    <div class="text-end">
        <button class="btn btn-primary" @onclick="ReverseThisString">Reverse the string</button>
    </div>
    <p role="contentinfo">Data entered: @inputString</p>
    @if (showResult)
    {
        <p role="contentinfo">Data transformed: @outputString</p>
    }
</div>

@code {
    private string inputString = "";
    private string outputString = "";
    private bool showResult = false;

    private void ReverseThisString()
    {
        showResult = true;
        outputString = string.Concat(inputString.ToCharArray().Reverse());
    }
}
