@page "/tasklist"
@using System.Text.Json
@inject IJSRuntime JS

<PageTitle>Tasklist</PageTitle>

<div class="d-flex align-items-center justify-content-center">
    <div class="task p-5">
        <div class="p-2 text-center mb-3">
            <img src="/img/task.jpg" width="300" />
        </div>
        <div>
            <EditForm Model="ti" OnValidSubmit="addItem">
                <DataAnnotationsValidator/>

                <div class="d-flex flex-row gap-2">
                    <InputText class="form-control" placeholder="Enter task" @bind-Value="ti.Title" />
                    <button class="btn btn-primary" type="submit">Add</button>
                </div>
                <div>
                    <ValidationMessage For="() => ti.Title" />
                </div>
            </EditForm>
        </div>
        <hr />
        <div class="vstack">
            
                @foreach (var item in list)
                {
                    <TaskItemComponent Item="item" OnDeleteCallback="deleteItem"></TaskItemComponent>
                }            
        </div>
    </div>
</div>


@code {
    private TaskItem ti = new TaskItem();
    private List<TaskItem> list = new List<TaskItem>();

    protected override async Task OnInitializedAsync()
    {
        await loadListAsync();

        await base.OnInitializedAsync();
    }

    private async Task addItem()
    {
        list.Add(ti);
        ti = new TaskItem();
        await saveListAsync();
    }

    private async Task deleteItem(TaskItem item)
    {
        await Task.Run(() => list.Remove(item));
    }

    private async Task saveListAsync()
    {
        string listJson = JsonSerializer.Serialize(list);
        await JS.InvokeVoidAsync("localStorage.setItem", $"taskList", listJson);
    }

    private async Task loadListAsync()
    {
        try
        {
            string? storageJson = await JS.InvokeAsync<string>("localStorage.getItem", $"taskList") ?? "[]";
            list = JsonSerializer.Deserialize<List<TaskItem>>(storageJson)!;
        }catch(Exception ex)
        {
            list = new List<TaskItem>();
            await saveListAsync();
        }
    }

    private async Task updateTask(TaskItem item)
    {
    }
}
